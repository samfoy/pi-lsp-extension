{
  "name": "pi-lsp-extension",
  "version": "1.4.0",
  "type": "module",
  "description": "Pi coding agent extension for LSP (Language Server Protocol) integration",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "lsp",
    "language-server",
    "tree-sitter"
  ],
  "license": "MIT",
  "author": "Sam Painter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samfoy/pi-lsp-extension.git"
  },
  "homepage": "https://github.com/samfoy/pi-lsp-extension#readme",
  "bugs": {
    "url": "https://github.com/samfoy/pi-lsp-extension/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && esbuild src/index.ts src/lsp-daemon.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist",
    "check": "tsc --noEmit",
    "test": "node --test --import tsx test/*.test.ts",
    "prepack": "npm run build"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "dependencies": {
    "tree-sitter-wasms": "^0.1.13",
    "vscode-languageserver-protocol": "^3.17.5",
    "web-tree-sitter": "^0.24.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.87.1",
    "@earendil-works/pi-tui": "^0.87.1",
    "@types/node": "^22.20.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typebox": "1.3.27",
    "typescript": "^5.9.3"
  }
}
